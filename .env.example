# AI Provider Configuration
AI_PROVIDER=gemini
AI_MODEL=gemini-2.0-flash-exp
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY

# Database Configuration (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Shopify Configuration
SHOPIFY_API_KEY=YOUR_APP_CLIENT_ID
SHOPIFY_API_SECRET=YOUR_APP_SECRET
REDIRECT_URL=https://localhost:3458/auth/callback

# App Configuration
APP_URL=https://localhost:3458
NODE_ENV=development

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# CORS - Comma separated list of allowed origins (leave empty for dynamic)
ALLOWED_ORIGINS=

# WhatsApp Integration (Phase 4)
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Analytics (Phase 3)
ANALYTICS_ENABLED=true

# Compliance (Phase 5)
DATA_RETENTION_DAYS=365
GDPR_ENABLED=true
CCPA_ENABLED=true
